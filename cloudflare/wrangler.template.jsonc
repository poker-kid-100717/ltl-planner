{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltl-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/health/*"]
  },
  "containers": [
    {
      "class_name": "LtlApi",
      "image": "../api/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "LtlApi" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LtlApi"] }
  ],
  "secrets": { "required": ["YARD_LTL_SIGNING_KEY"] },
  "triggers": { "crons": ["23 8 * * *"] },
  "observability": { "enabled": true }
}
