# PostgreSQL for the API. Leave empty to use the compose database; any postgres:// URL works
# (for example a Neon pooled URL ending in ?sslmode=require).
DATABASE_URL=

# Optional: enables POST /api/admin/reset-demo with this token in X-Demo-Reset-Token.
DEMO_RESET_TOKEN=

# Demo is the safe/default provider. Set Live only with credentials you own.
ALVYS_MODE=Demo
ALVYS_CLIENT_ID=
ALVYS_CLIENT_SECRET=
ALVYS_TOKEN_URL=https://auth.alvys.com/oauth/token
ALVYS_AUDIENCE=https://api.alvys.com/public/
ALVYS_API_BASE_URL=https://integrations.alvys.com/api/p/
ALVYS_LOAD_API_VERSION=v1

# Dev-only shared secret used to verify signed Yard Ops events.
# Must match YARD_LTL_SIGNING_KEY in the Yard Ops deployment. Use a secret store in any real deployment.
YARD_LTL_SIGNING_KEY=portfolio-dev-only-change-me
